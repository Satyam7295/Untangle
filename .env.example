# Server-only configuration. Never commit real credentials or secrets.
DATABASE_URL=
# Use any fictional administrator ID and password for local development.
ADMIN_ID=
ADMIN_PASSWORD=
# Use a random value of at least 32 characters (for example: openssl rand -base64 32).
SESSION_SECRET=
ADMIN_TENANT_ID=
# Server-only Groq credentials. Obtain an API key from https://console.groq.com/keys.
GROQ_API_KEY=
# Optional; defaults to llama-3.3-70b-versatile.
GROQ_MODEL=llama-3.3-70b-versatile
# OpenAI-compatible embedding service configuration.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
# Optional ingestion limits.
POLICY_MAX_UPLOAD_BYTES=20971520
POLICY_CHUNK_SIZE=1800
POLICY_CHUNK_OVERLAP=200
