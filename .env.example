# Server-only configuration. Never commit real credentials or secrets.
DATABASE_URL=
# Use any fictional administrator ID and password for local development.
ADMIN_ID=
ADMIN_PASSWORD=
# Use a random value of at least 32 characters (for example: openssl rand -base64 32).
SESSION_SECRET=
# Tenant scope for the configured admin account. This value is never accepted from the browser.
ADMIN_TENANT_SLUG=default
# Private local PDF storage directory. Keep this outside public/static directories.
POLICY_STORAGE_DIR=.data/policies
# Embedding provider is intentionally separate from any future Groq LLM provider.
EMBEDDING_PROVIDER=openai
EMBEDDING_API_URL=https://api.openai.com/v1/embeddings
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
OPENAI_API_KEY=
# Reserved for future Groq LLM inference. Groq does not currently provide a documented embeddings API.
GROQ_API_KEY=
GROQ_MODEL=
