    "@types/node": "22.15.33",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "@vitejs/plugin-react": "4.4.1",
    "eslint": "9.39.1",
    "eslint-config-next": "15.5.28",
    "jsdom": "26.1.0",
